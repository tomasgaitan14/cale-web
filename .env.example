# Clave pública del captcha (Cloudflare Turnstile). Va al navegador: no es secreta. Se carga en .env.local y en Vercel.
PUBLIC_TURNSTILE_SITE_KEY=

# Solo para la función api/lead.ts (servidor). Secretas: van en Vercel (Production) y, para probar con `vercel dev`,
# en .env.local. Nunca en el código ni con prefijo PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
