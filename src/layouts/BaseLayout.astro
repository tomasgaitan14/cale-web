---
import '../styles/global.css';
import AppButton from '../components/AppButton.astro';
import Brand from '../components/Brand.astro';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import {
  BUSINESS_NAME,
  CONTACT_EMAIL,
  FACEBOOK_DOMAIN_VERIFICATION,
  LOCATION,
  ROUTES,
} from '../config';
import { APPLE_TOUCH_ICON, OG_IMAGE } from '../lib/brand';
import { jsonLd } from '../lib/structured-data';
import { canonicalUrl, mailtoUrl } from '../lib/url';

interface Props {
  title: string;
  description: string;
  // Ruta canónica. Sin ruta (como en la 404), la página no se indexa.
  path?: string;
  // Datos estructurados (JSON-LD) de la página, si los tiene
  structuredData?: object;
}

const { title, description, path, structuredData } = Astro.props;
const canonical = path ? canonicalUrl(path) : undefined;
const ogImageUrl = canonicalUrl(OG_IMAGE.path);
// Las dos tipografías del sitio (títulos y texto), solo el subconjunto latino que usa el español: se piden junto con el
// HTML en vez de esperar a que se descargue el CSS
const FONT_PRELOADS = [manropeLatin, dmSansLatin];
const year = new Date().getFullYear();

const LEGAL_LINKS = [
  { href: ROUTES.privacy, label: 'Política de privacidad' },
  { href: ROUTES.terms, label: 'Términos de servicio' },
  { href: ROUTES.dataDeletion, label: 'Eliminar mis datos' },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={canonical ? 'index, follow' : 'noindex'} />
    <meta name="author" content={BUSINESS_NAME} />
    <meta name="theme-color" content="#f7f4ee" />
    <meta name="facebook-domain-verification" content={FACEBOOK_DOMAIN_VERIFICATION} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={APPLE_TOUCH_ICON.path} />
    {FONT_PRELOADS.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {structuredData && <script type="application/ld+json" set:html={jsonLd(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="container">
        <div class="header-pill">
          <a class="home-link" href={ROUTES.home} aria-label={`${BUSINESS_NAME}, inicio`}><Brand /></a>
          <div class="header-actions">
            <AppButton compact />
          </div>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          {BUSINESS_NAME} · {LOCATION}.
        </p>
        <p>
          Escribinos a <a href={mailtoUrl(CONTACT_EMAIL)}>{CONTACT_EMAIL}</a>.
        </p>
        <nav aria-label="Legal">
          <ul class="footer-links">
            {
              LEGAL_LINKS.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="footer-fine-print">
          © {year} {BUSINESS_NAME}. WhatsApp y Meta son marcas de Meta Platforms, Inc.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Pastilla flotante de vidrio: borde interno claro y sombra teñida del color del fondo (no negra) */
  .site-header {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    margin-top: 0.75rem;
  }

  .header-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.375rem 0.375rem 0.375rem 1.125rem;
    background: rgb(255 255 255 / 0.82);
    border: 1px solid rgb(255 255 255 / 0.9);
    border-radius: 999px;
    box-shadow:
      var(--shadow-float),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
  }

  /* Sin soporte de desenfoque, el vidrio pasa a blanco liso para que el texto siga leyéndose */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .header-pill {
      background: var(--surface);
    }
  }

  .home-link {
    text-decoration: none;
  }

  .header-actions {
    display: flex;
    gap: 0.5rem;
  }

  .header-actions :global(.button) {
    border-radius: 999px;
  }

  /* En el celular el botón no ocupa todo el ancho: queda al lado de la marca */
  @media (max-width: 39.99rem) {
    .header-actions :global(.button) {
      width: auto;
    }
  }

  .site-footer {
    padding-block: 3rem 3.5rem;
    background: var(--surface);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .footer-inner {
    display: grid;
    gap: 0.75rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-fine-print {
    margin-top: 1rem;
  }
</style>
