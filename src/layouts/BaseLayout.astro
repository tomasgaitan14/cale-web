---
import '../styles/global.css';
import AppButton from '../components/AppButton.astro';
import Brand from '../components/Brand.astro';
import {
  BUSINESS_NAME,
  LANDING_COPY,
  CONTACT_EMAIL,
  FACEBOOK_DOMAIN_VERIFICATION,
  LOCATION,
  OWNER_NAME,
  ROUTES,
  WHATSAPP_GREETING,
  WHATSAPP_NUMBER,
} from '../config';
import { canonicalUrl, mailtoUrl, whatsappUrl } from '../lib/url';

interface Props {
  title: string;
  description: string;
  // Ruta canónica. Sin ruta (como en la 404), la página no se indexa.
  path?: string;
}

const { title, description, path } = Astro.props;
const canonical = path ? canonicalUrl(path) : undefined;
const year = new Date().getFullYear();

const LEGAL_LINKS = [
  { href: ROUTES.privacy, label: 'Política de privacidad' },
  { href: ROUTES.terms, label: 'Términos de servicio' },
  { href: ROUTES.dataDeletion, label: 'Eliminar mis datos' },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={canonical ? 'index, follow' : 'noindex'} />
    <meta name="author" content={OWNER_NAME} />
    <meta name="theme-color" content="#f7f4ee" />
    <meta name="facebook-domain-verification" content={FACEBOOK_DOMAIN_VERIFICATION} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="home-link" href={ROUTES.home} aria-label={`${BUSINESS_NAME}, inicio`}><Brand /></a>
        <div class="header-actions">
          <AppButton variant="secondary" label={LANDING_COPY.signIn} compact />
          <AppButton compact class="header-start" />
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          {BUSINESS_NAME} es un servicio de {OWNER_NAME}, {LOCATION}.
        </p>
        <p>
          Escribinos por <a href={whatsappUrl(WHATSAPP_NUMBER, WHATSAPP_GREETING)}>WhatsApp</a> o a <a href={mailtoUrl(CONTACT_EMAIL)}>{CONTACT_EMAIL}</a>.
        </p>
        <nav aria-label="Legal">
          <ul class="footer-links">
            {
              LEGAL_LINKS.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="footer-fine-print">
          © {year} {BUSINESS_NAME}. WhatsApp y Meta son marcas de Meta Platforms, Inc.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .home-link {
    text-decoration: none;
  }

  .header-actions {
    display: flex;
    gap: 0.5rem;
  }

  /* En el celular los dos no entran al lado de la marca, y "Empezar gratis" ya está en la portada: arriba queda solo
     "Ingresar a mi cuenta" */
  @media (max-width: 39.99rem) {
    .header-actions :global(.header-start) {
      display: none;
    }

    .header-actions :global(.button) {
      width: auto;
    }
  }

  .site-footer {
    padding-block: 3rem 3.5rem;
    background: var(--surface);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .footer-inner {
    display: grid;
    gap: 0.75rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-fine-print {
    margin-top: 1rem;
  }
</style>
