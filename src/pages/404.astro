---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_NAME, ROUTES } from '../config';
---

<BaseLayout
  title={`Página no encontrada · ${BUSINESS_NAME}`}
  description={`La página que buscás no existe en el sitio de ${BUSINESS_NAME}.`}
>
  <section class="container not-found">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página no existe.</h1>
    <p class="lede">Puede que el link esté mal escrito o que la página se haya movido.</p>
    <a class="button button-primary" href={ROUTES.home}>Volver al inicio</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: var(--section-space);
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
  }
</style>
