---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_NAME, ROUTES } from '../config';
---

<BaseLayout
  title={`Página no encontrada · ${BUSINESS_NAME}`}
  description={`La página que buscás no existe en el sitio de ${BUSINESS_NAME}.`}
>
  <section class="container not-found">
    <h1>Esta página no existe</h1>
    <p class="not-found-text">Puede que el link esté mal escrito o que la página se haya movido.</p>
    <a class="button" href={ROUTES.home}>Volver al inicio</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: var(--section-space);
  }

  .not-found-text {
    color: var(--muted);
  }

  h1 {
    font-size: var(--fs-h1-sm);
  }
</style>
