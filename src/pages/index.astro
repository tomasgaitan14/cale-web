---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PhonePreview from '../components/PhonePreview.astro';
import AppButton from '../components/AppButton.astro';
import {
  BUSINESS_NAME,
  CONTACT_EMAIL,
  HOW_IT_WORKS,
  LANDING_COPY,
  ROUTES,
  WHATSAPP_GREETING,
  WHATSAPP_NUMBER,
} from '../config';
import { mailtoUrl, whatsappUrl } from '../lib/url';
---

<BaseLayout
  title={`${BUSINESS_NAME} · Recordatorios de turnos por WhatsApp`}
  description={`${BUSINESS_NAME} envía por WhatsApp los recordatorios de los turnos que anotás en Google Calendar. Tu cliente confirma o cancela con un botón.`}
  path={ROUTES.home}
>
  <section class="hero" aria-labelledby="portada-titulo">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="pill"><span class="dot" aria-hidden="true"></span>{LANDING_COPY.audience}</p>
        <h1 id="portada-titulo">{LANDING_COPY.title}</h1>
        <p class="lead">{LANDING_COPY.subtitle}</p>
        <AppButton />
        <p class="tagline"><Icon name="check" class="tagline-icon" />{LANDING_COPY.tagline}</p>
      </div>
      <PhonePreview />
    </div>
  </section>

  <section class="section how" id="como-funciona" aria-labelledby="como-funciona-titulo">
    <div class="container">
      <h2 id="como-funciona-titulo">Cómo funciona</h2>
      <ol class="how-list">
        {
          HOW_IT_WORKS.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section closing-section" id="empezar" aria-labelledby="empezar-titulo">
    <div class="container">
      <div class="closing">
        <h2 id="empezar-titulo">{LANDING_COPY.closing}</h2>
        <AppButton />
      </div>
      <p class="contact" id="contacto">
        ¿Tenés dudas? Escribinos por <a href={whatsappUrl(WHATSAPP_NUMBER, WHATSAPP_GREETING)}>WhatsApp</a> o a{' '}
        <a href={mailtoUrl(CONTACT_EMAIL)}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Portada --- */

  .hero {
    padding-block: 1.25rem 0;
  }

  .hero-grid {
    display: grid;
    gap: 1.5rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pill {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    border-radius: 50%;
  }

  .hero h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
  }

  .lead {
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .tagline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .tagline :global(.tagline-icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--link);
  }

  /* --- Cómo funciona --- */

  .how h2 {
    margin-bottom: 1rem;
    font-size: var(--fs-h2);
  }

  .how-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  /* Es una secuencia real: el número ayuda a seguir el orden */
  .how-list li {
    padding: 1.375rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sheet);
    counter-increment: step;
  }

  .how-list li::before {
    content: counter(step);
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.875rem;
    background: var(--tint);
    border-radius: var(--radius-field);
    color: var(--link);
    font: var(--fw-head) 1.125rem/2.5rem var(--font-head);
    text-align: center;
  }

  .how-list h3 {
    margin-bottom: 0.375rem;
    font-size: var(--fs-h3);
    line-height: 1.25;
  }

  .how-list p {
    color: var(--muted);
  }

  /* --- Cierre: banda negra con el botón verde --- */

  .closing-section {
    padding-top: 0;
  }

  .closing {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    padding: 1.75rem 1.375rem;
    background: var(--ink);
    border-radius: 24px;
    color: var(--on-ink);
  }

  .closing::after {
    content: '';
    position: absolute;
    top: -110px;
    right: -80px;
    width: 220px;
    height: 220px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 50%;
    box-shadow: 0 0 0 30px rgb(255 255 255 / 0.03);
  }

  .closing h2 {
    position: relative;
    font-size: var(--fs-h2);
    letter-spacing: -0.04em;
  }

  .closing :global(.button) {
    position: relative;
    z-index: 1;
  }

  .contact {
    margin-top: 1.5rem;
    text-align: center;
  }

  /* --- Escritorio: cambia la composición, no el contenido --- */

  @media (min-width: 60rem) {
    .hero {
      padding-top: 3rem;
    }

    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      column-gap: 3.5rem;
      align-items: center;
    }

    .hero h1 {
      font-size: var(--fs-h1-desktop);
    }

    .hero-copy :global(.button) {
      align-self: flex-start;
    }

    .how-list {
      grid-template-columns: repeat(3, 1fr);
    }

    .closing {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding: 2.5rem;
    }

    .closing :global(.button) {
      flex: none;
    }
  }
</style>
