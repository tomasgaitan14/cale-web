---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TrialButton from '../components/TrialButton.astro';
import {
  APP_URL,
  BUSINESS_NAME,
  CONTACT_EMAIL,
  INSTALL_SECTION_ID,
  ROUTES,
  TRIAL_DAYS,
  WHATSAPP_GREETING,
  WHATSAPP_HELP_GREETING,
  WHATSAPP_NUMBER,
} from '../config';
import { mailtoUrl, whatsappUrl } from '../lib/url';

// Comparación de la portada: cada fila es el mismo momento del día, sin Cale y con Cale
const COMPARISON = [
  {
    without: 'Llamás o escribís uno por uno para confirmar cada turno.',
    with: `${BUSINESS_NAME} les escribe a todos por WhatsApp antes del turno.`,
  },
  {
    without: 'Si alguien no puede venir, te enterás cuando no aparece.',
    with: 'Si alguien cancela, te enterás antes y podés dar ese lugar a otro.',
  },
  {
    without: 'Perseguís respuestas que no llegan.',
    with: 'Tu cliente responde con un toque: confirma, cancela o pide otro horario.',
  },
  {
    without: 'Repasás el cuaderno a mano todos los días.',
    with: `Anotás el turno en tu calendario y ${BUSINESS_NAME} hace el resto.`,
  },
];

// Ejemplo del dibujo de la portada: el renglón marcado es el que se convierte en el mensaje
const AGENDA_ROWS = [
  { time: '10:00', client: 'Marta', service: 'color' },
  { time: '17:30', client: 'Lucía', service: 'corte', marked: true },
  { time: '18:30', client: 'Sofía', service: 'brushing' },
];

const QUICK_REPLIES = ['Confirmo', 'Cancelo', 'Cambiar horario'];

// Video de la instalación (proyecto cale-video, Remotion): vertical 9:16, sin sonido; los textos en pantalla cuentan todo
const INSTALL_VIDEO = {
  src: '/video/cale-instalacion.mp4',
  poster: '/video/cale-instalacion.jpg',
  width: 1080,
  height: 1920,
  label: `Video: cómo se instala ${BUSINESS_NAME} en 4 pasos y cómo le llega el recordatorio a tu cliente por WhatsApp`,
};

// Resumen del asistente de alta (cale-app): el detalle de cada paso lo explica el asistente
const INSTALL_STEPS = [
  'Ingresá los datos de tu negocio.',
  'Te creamos un calendario de turnos automáticamente.',
  'Conectás tu WhatsApp.',
  'Ya podés usarlo.',
];
---

<BaseLayout
  title={`${BUSINESS_NAME} · Recordatorios de turnos por WhatsApp`}
  description={`${BUSINESS_NAME} le avisa por WhatsApp a cada cliente antes de su turno, desde el mismo número de tu negocio. Tu cliente confirma con un toque.`}
  path={ROUTES.home}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>{BUSINESS_NAME} confirma tus turnos y te los reprograma por WhatsApp</h1>
        <p class="lede">
          {BUSINESS_NAME} se encarga de escribirles por WhatsApp a tus clientes antes de su turno, desde el mismo número de
          tu negocio, y te ahorra el trabajo de confirmar uno por uno.
        </p>
        <div class="hero-actions">
          <TrialButton />
          <a class="text-link" href="#comparacion">Ver cómo funciona</a>
        </div>
      </div>

      <figure class="scene">
        <div class="agenda">
          <p class="agenda-day">Jueves 16</p>
          <ul class="agenda-rows">
            {
              AGENDA_ROWS.map((row) => (
                <li class:list={{ 'agenda-row-marked': row.marked }}>
                  <span class="agenda-time">{row.time}</span> {row.client}, {row.service}
                </li>
              ))
            }
          </ul>
        </div>

        <svg class="scene-arrow" viewBox="0 0 48 48" aria-hidden="true">
          <path d="M8 24h30M28 13l11 11-11 11" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>

        <div class="chat">
          <p class="chat-business">Peluquería Clara</p>
          <p class="bubble">Hola Lucía, te esperamos mañana jueves a las 17:30 para tu corte. ¿Venís?</p>
          <ul class="quick-replies">
            {QUICK_REPLIES.map((reply) => <li>{reply}</li>)}
          </ul>
          <p class="bubble bubble-reply">
            Confirmo <Icon name="checks" class="reply-check" />
          </p>
        </div>

        <figcaption>El turno que anotaste se convierte en el WhatsApp que le llega a tu cliente.</figcaption>
      </figure>
    </div>
  </section>





  <section class="section" id="para-quien" aria-labelledby="para-quien-titulo">
    <div class="container narrow">
      <h2 id="para-quien-titulo">Cada turno que se olvidan es plata que perdés</h2>
      <p>
        Peluquerías, barberías, centros de estética, consultorios: si trabajás con turnos, cada cliente que no viene deja
        un hueco que ya no recuperás.
      </p>
    </div>
  </section>

  <section class="section" id="comparacion" aria-labelledby="comparacion-titulo">
    <div class="container narrow">
      <h2 id="comparacion-titulo">Mirá cómo puede cambiar tu día a día</h2>
      <table class="compare">
        <thead>
          <tr>
            <th scope="col" class="compare-without">Sin {BUSINESS_NAME}</th>
            <th scope="col" class="compare-with">Con {BUSINESS_NAME}</th>
          </tr>
        </thead>
        <tbody>
          {
            COMPARISON.map((row) => (
              <tr>
                <td class="compare-without" data-label={`Sin ${BUSINESS_NAME}`}>
                  <div class="compare-cell">
                    <Icon name="x" class="compare-icon" />
                    <span>{row.without}</span>
                  </div>
                </td>
                <td class="compare-with" data-label={`Con ${BUSINESS_NAME}`}>
                  <div class="compare-cell">
                    <Icon name="check" class="compare-icon" />
                    <span>{row.with}</span>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="section-action">
        <TrialButton />
      </div>
    </div>
  </section>

  <section class="section" id="mismo-numero" aria-labelledby="mismo-numero-titulo">
    <div class="container narrow">
      <h2 id="mismo-numero-titulo">Seguís usando tu WhatsApp como siempre</h2>
      <p>
        Si ya atendés con WhatsApp Business, no cambiás nada: el mismo número, el mismo celular y las mismas
        conversaciones. {BUSINESS_NAME} solo se encarga de los turnos: los recuerda, los cambia y los toma cuando un
        cliente te escribe “turno”.
      </p>
    </div>
  </section>

  <section class="section" id={INSTALL_SECTION_ID} aria-labelledby="instalacion-titulo">
    <div class="container narrow install-layout">
      <h2 id="instalacion-titulo" class="install-title">Hacé la instalación por tu cuenta y probalo gratis por {TRIAL_DAYS} días</h2>
      <figure class="install-video">
        <video
          src={INSTALL_VIDEO.src}
          poster={INSTALL_VIDEO.poster}
          width={INSTALL_VIDEO.width}
          height={INSTALL_VIDEO.height}
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
          aria-label={INSTALL_VIDEO.label}></video>
      </figure>
      <div class="install-body">
        <ol class="steps install-steps">
          {INSTALL_STEPS.map((step) => <li>{step}</li>)}
        </ol>
        <div class="install-action">
          <TrialButton href={APP_URL} />
        </div>
        <p class="install-cost">
          {BUSINESS_NAME} es gratis los primeros {TRIAL_DAYS} días. WhatsApp cobra los mensajes aparte: son centavos.
        </p>
        <p class="install-help">
          ¿Te trabás en algún paso? <a href={whatsappUrl(WHATSAPP_NUMBER, WHATSAPP_HELP_GREETING)}>Escribinos por WhatsApp</a> y
          lo hacemos juntos.
        </p>
      </div>
    </div>
  </section>

  <section class="section closing" id="contacto" aria-labelledby="contacto-titulo">
    <div class="container narrow">
      <h2 id="contacto-titulo">Probalo gratis {TRIAL_DAYS} días en tu negocio</h2>
      <div class="closing-action">
        <TrialButton href={APP_URL} />
      </div>
      <p class="closing-contact">
        ¿Tenés dudas? Escribinos por <a href={whatsappUrl(WHATSAPP_NUMBER, WHATSAPP_GREETING)}>WhatsApp</a> o a{' '}
        <a href={mailtoUrl(CONTACT_EMAIL)}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Portada --- */

  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) var(--section-space);
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .lede {
    max-width: var(--reading-width);
    margin-top: 1.5rem;
    color: var(--color-graphite);
    font-size: 1.375rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .text-link {
    font-weight: 700;
  }

  /* --- Dibujo: renglón de agenda → WhatsApp --- */

  /* Agenda arriba a la izquierda, flecha y WhatsApp abajo a la derecha */
  .scene {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.5rem;
    width: 100%;
    max-width: 28rem;
    margin: 0 auto;
  }

  .agenda {
    grid-column: 1 / -1;
    justify-self: start;
    width: 100%;
    max-width: 17rem;
    padding: 1.25rem 1.25rem 1.5rem;
    /* Renglones de cuaderno */
    background:
      repeating-linear-gradient(to bottom, transparent 0 2.75rem, var(--color-rule) 2.75rem calc(2.75rem + 1px)),
      var(--color-paper);
    background-position: 0 3.25rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    transform: rotate(-1.5deg);
  }

  .agenda-day {
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .agenda-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.125rem;
  }

  .agenda-rows li {
    position: relative;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    height: 2.75rem;
    white-space: nowrap;
  }

  .agenda-time {
    font-weight: 700;
  }

  /* Resaltador sobre el turno que se recuerda */
  .agenda-row-marked::before {
    content: '';
    position: absolute;
    inset: 0.375rem -0.375rem;
    z-index: -1;
    background: var(--color-highlight);
    border-radius: 3px;
    transform-origin: left center;
  }

  .agenda-row-marked {
    isolation: isolate;
  }

  /* Flecha en diagonal: del renglón de la agenda al mensaje */
  .scene-arrow {
    align-self: start;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0.5rem 0 0 4rem;
    color: var(--color-graphite);
    transform: rotate(45deg);
  }

  .chat {
    justify-self: end;
    margin-top: -1.5rem;
    display: grid;
    gap: 0.625rem;
    width: 100%;
    max-width: 19rem;
    padding: 1rem;
    background: var(--color-paper-alt);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .chat-business {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
    font-weight: 700;
  }

  .bubble {
    max-width: 92%;
    padding: 0.75rem 0.875rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    border-top-left-radius: 4px;
  }

  .quick-replies {
    display: grid;
    gap: 0.375rem;
    max-width: 92%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quick-replies li {
    padding: 0.375rem 0.5rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-align: center;
  }

  .bubble-reply {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    justify-self: end;
    background: var(--color-bubble);
    border-color: transparent;
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: 4px;
    font-weight: 700;
  }

  .bubble-reply :global(.reply-check) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .scene figcaption {
    grid-column: 1 / -1;
    margin-top: 0.75rem;
    color: var(--color-graphite);
    font-size: 1rem;
  }

  /* Único movimiento de la página: se marca el turno, aparece el mensaje y llega la respuesta */
  @keyframes mark {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .agenda-row-marked::before {
      animation: mark 700ms var(--ease-out) 400ms both;
    }

    .chat {
      animation: arrive 600ms var(--ease-out) 1100ms both;
    }

    .bubble-reply {
      animation: arrive 500ms var(--ease-out) 2000ms both;
    }
  }

  /* --- Secciones --- */

  .narrow {
    max-width: calc(var(--reading-width) + 2 * var(--gutter) + 6rem);
  }

  .section h2 {
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
  }

  .section h2 + p,
  .section h2 + ol {
    margin-top: 1.25rem;
  }

  /* --- Comparación: "sin" en rojo con una X, "con" en verde con un check, cada columna con su fondo --- */

  .compare {
    margin-top: 2rem;
    border-collapse: separate;
    border-spacing: 0.5rem;
    margin-inline: -0.5rem;
    width: calc(100% + 1rem);
    text-align: left;
  }

  .compare th {
    padding: 0 0 0.25rem;
    font-size: 1.125rem;
    font-weight: 800;
  }

  .compare td {
    width: 50%;
    padding: 1rem 1.125rem;
    border-radius: var(--radius-sm);
    vertical-align: top;
  }

  .compare-cell {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .compare-icon {
    margin-top: 0.15rem;
  }

  .compare-without {
    color: var(--color-without);
  }

  td.compare-without {
    background: var(--color-without-bg);
  }

  .compare-with {
    color: var(--color-with);
    font-weight: 600;
  }

  td.compare-with {
    background: var(--color-with-bg);
  }

  /* En el celular cada par se lee junto: primero "sin", después "con", con su etiqueta */
  @media (max-width: 40rem) {
    .compare thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .compare,
    .compare tbody,
    .compare tr,
    .compare td {
      display: block;
      width: auto;
    }

    .compare {
      margin-inline: 0;
    }

    .compare tr {
      margin-bottom: 1.25rem;
    }

    .compare td + td {
      margin-top: 0.5rem;
    }

    .compare td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.25rem;
      font-size: 1rem;
      font-weight: 800;
    }
  }

  .steps {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  /* Es una secuencia real: los números ayudan a seguir el orden */
  .steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    align-items: center;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--color-ink);
    border-radius: 50%;
    color: var(--color-paper);
    font-size: 1.375rem;
    font-weight: 800;
  }

  /* Instalación: en el celular, título, video y pasos uno abajo del otro; en la PC, los pasos y el video lado a lado */
  .install-layout {
    display: grid;
    grid-template-areas:
      'title'
      'video'
      'body';
    row-gap: 2rem;
  }

  .install-title {
    grid-area: title;
  }

  .install-video {
    grid-area: video;
    max-width: 16rem;
    margin: 0;
  }

  .install-video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-md);
    background: var(--color-paper-alt);
  }

  .install-body {
    grid-area: body;
  }

  @media (min-width: 52rem) {
    .install-layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
      grid-template-areas:
        'title title'
        'body video';
      column-gap: 3rem;
    }
  }

  .install-action,
  .section-action {
    margin-top: 2rem;
  }

  /* Letra chica: el costo de WhatsApp se dice desde el principio, sin competir con el botón */
  .install-cost {
    margin-top: 0.75rem;
    color: var(--color-graphite);
    font-size: 1rem;
  }

  .install-help {
    margin-top: 1rem;
  }

  .closing {
    background: var(--color-paper-alt);
  }

  .closing-action {
    margin-top: 2rem;
  }

  .closing-contact {
    margin-top: 1.25rem;
  }
</style>
