---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { BUSINESS_NAME, CONTACT_EMAIL, ROUTES } from '../config';
import { mailtoUrl } from '../lib/url';

const STEPS = [
  'Anotás el turno en el calendario del celular, en lugar del cuaderno.',
  `Antes del turno, ${BUSINESS_NAME} le escribe a tu cliente desde tu WhatsApp.`,
  'Tu cliente toca "Confirmo", "Cancelo" o "Cambiar horario", y vos lo ves en tu WhatsApp.',
];

// Ejemplo del dibujo de la portada: el renglón marcado es el que se convierte en el mensaje
const AGENDA_ROWS = [
  { time: '10:00', client: 'Marta', service: 'color' },
  { time: '17:30', client: 'Lucía', service: 'corte', marked: true },
  { time: '18:30', client: 'Sofía', service: 'brushing' },
];

const QUICK_REPLIES = ['Confirmo', 'Cancelo', 'Cambiar horario'];
---

<BaseLayout
  title={`${BUSINESS_NAME} · Recordatorios de turnos por WhatsApp`}
  description={`${BUSINESS_NAME} le avisa por WhatsApp a cada cliente antes de su turno, desde el mismo número de tu negocio. Tu cliente confirma con un toque.`}
  path={ROUTES.home}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Dejá de llamar uno por uno para confirmar turnos</h1>
        <p class="lede">
          {BUSINESS_NAME} le manda un WhatsApp a cada cliente antes de su turno, desde el mismo número que ya usás en tu
          negocio. Tu cliente confirma con un toque.
        </p>
        <div class="hero-actions">
          <WhatsAppButton />
          <a class="text-link" href="#como-funciona">Ver cómo funciona</a>
        </div>
      </div>

      <figure class="scene">
        <div class="agenda">
          <p class="agenda-day">Jueves 16</p>
          <ul class="agenda-rows">
            {
              AGENDA_ROWS.map((row) => (
                <li class:list={{ 'agenda-row-marked': row.marked }}>
                  <span class="agenda-time">{row.time}</span> {row.client}, {row.service}
                </li>
              ))
            }
          </ul>
        </div>

        <svg class="scene-arrow" viewBox="0 0 48 48" aria-hidden="true">
          <path d="M8 24h30M28 13l11 11-11 11" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>

        <div class="chat">
          <p class="chat-business">Peluquería Clara</p>
          <p class="bubble">Hola Lucía, te esperamos mañana jueves a las 17:30 para tu corte. ¿Venís?</p>
          <ul class="quick-replies">
            {QUICK_REPLIES.map((reply) => <li>{reply}</li>)}
          </ul>
          <p class="bubble bubble-reply">
            Confirmo <Icon name="checks" class="reply-check" />
          </p>
        </div>

        <figcaption>El turno que anotaste se convierte en el WhatsApp que le llega a tu cliente.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="como-funciona" aria-labelledby="como-funciona-titulo">
    <div class="container narrow">
      <h2 id="como-funciona-titulo">Así de simple</h2>
      <ol class="steps">
        {STEPS.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="mismo-numero" aria-labelledby="mismo-numero-titulo">
    <div class="container narrow">
      <h2 id="mismo-numero-titulo">Seguís usando tu WhatsApp como siempre</h2>
      <p>
        Si ya atendés con WhatsApp Business, no cambiás nada: el mismo número, el mismo celular y las mismas
        conversaciones. {BUSINESS_NAME} solo se encarga de los recordatorios.
      </p>
    </div>
  </section>

  <section class="section" id="para-quien" aria-labelledby="para-quien-titulo">
    <div class="container narrow">
      <h2 id="para-quien-titulo">Pensado para negocios con turnos</h2>
      <p>
        Peluquerías, barberías, centros de estética, consultorios y cualquiera que hoy anote los turnos en un cuaderno.
      </p>
    </div>
  </section>

  <section class="section closing" id="contacto" aria-labelledby="contacto-titulo">
    <div class="container narrow">
      <h2 id="contacto-titulo">¿Lo querés probar en tu negocio?</h2>
      <p>Escribinos y te ayudamos a dejarlo andando.</p>
      <div class="closing-action">
        <WhatsAppButton />
      </div>
      <p class="closing-email">
        También por mail: <a href={mailtoUrl(CONTACT_EMAIL)}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Portada --- */

  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) var(--section-space);
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .lede {
    max-width: var(--reading-width);
    margin-top: 1.5rem;
    color: var(--color-graphite);
    font-size: 1.375rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .text-link {
    font-weight: 700;
  }

  /* --- Dibujo: renglón de agenda → WhatsApp --- */

  /* Agenda arriba a la izquierda, flecha y WhatsApp abajo a la derecha */
  .scene {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.5rem;
    width: 100%;
    max-width: 28rem;
    margin: 0 auto;
  }

  .agenda {
    grid-column: 1 / -1;
    justify-self: start;
    width: 100%;
    max-width: 17rem;
    padding: 1.25rem 1.25rem 1.5rem;
    /* Renglones de cuaderno */
    background:
      repeating-linear-gradient(to bottom, transparent 0 2.75rem, var(--color-rule) 2.75rem calc(2.75rem + 1px)),
      var(--color-paper);
    background-position: 0 3.25rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    transform: rotate(-1.5deg);
  }

  .agenda-day {
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .agenda-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.125rem;
  }

  .agenda-rows li {
    position: relative;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    height: 2.75rem;
    white-space: nowrap;
  }

  .agenda-time {
    font-weight: 700;
  }

  /* Resaltador sobre el turno que se recuerda */
  .agenda-row-marked::before {
    content: '';
    position: absolute;
    inset: 0.375rem -0.375rem;
    z-index: -1;
    background: var(--color-highlight);
    border-radius: 3px;
    transform-origin: left center;
  }

  .agenda-row-marked {
    isolation: isolate;
  }

  /* Flecha en diagonal: del renglón de la agenda al mensaje */
  .scene-arrow {
    align-self: start;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0.5rem 0 0 4rem;
    color: var(--color-graphite);
    transform: rotate(45deg);
  }

  .chat {
    justify-self: end;
    margin-top: -1.5rem;
    display: grid;
    gap: 0.625rem;
    width: 100%;
    max-width: 19rem;
    padding: 1rem;
    background: var(--color-paper-alt);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .chat-business {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
    font-weight: 700;
  }

  .bubble {
    max-width: 92%;
    padding: 0.75rem 0.875rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    border-top-left-radius: 4px;
  }

  .quick-replies {
    display: grid;
    gap: 0.375rem;
    max-width: 92%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quick-replies li {
    padding: 0.375rem 0.5rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-align: center;
  }

  .bubble-reply {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    justify-self: end;
    background: var(--color-bubble);
    border-color: transparent;
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: 4px;
    font-weight: 700;
  }

  .bubble-reply :global(.reply-check) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .scene figcaption {
    grid-column: 1 / -1;
    margin-top: 0.75rem;
    color: var(--color-graphite);
    font-size: 1rem;
  }

  /* Único movimiento de la página: se marca el turno, aparece el mensaje y llega la respuesta */
  @keyframes mark {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .agenda-row-marked::before {
      animation: mark 700ms var(--ease-out) 400ms both;
    }

    .chat {
      animation: arrive 600ms var(--ease-out) 1100ms both;
    }

    .bubble-reply {
      animation: arrive 500ms var(--ease-out) 2000ms both;
    }
  }

  /* --- Secciones --- */

  .narrow {
    max-width: calc(var(--reading-width) + 2 * var(--gutter) + 6rem);
  }

  .section h2 {
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
  }

  .section h2 + p,
  .section h2 + ol {
    margin-top: 1.25rem;
  }

  .steps {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  /* Es una secuencia real: los números ayudan a seguir el orden */
  .steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    align-items: center;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--color-ink);
    border-radius: 50%;
    color: var(--color-paper);
    font-size: 1.375rem;
    font-weight: 800;
  }

  .closing {
    background: var(--color-paper-alt);
  }

  .closing-action {
    margin-top: 2rem;
  }

  .closing-email {
    margin-top: 1.5rem;
    color: var(--color-graphite);
    font-size: 1.125rem;
  }
</style>
