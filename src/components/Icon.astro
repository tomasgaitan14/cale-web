---
// Íconos Phosphor (peso Bold) como SVG inline: sin JS ni pedidos extra.
import checks from '@phosphor-icons/core/bold/checks-bold.svg?raw';
import whatsappLogo from '@phosphor-icons/core/bold/whatsapp-logo-bold.svg?raw';

const ICONS = {
  checks,
  'whatsapp-logo': whatsappLogo,
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span class:list={['icon', className]} aria-hidden="true" set:html={ICONS[name]} />
