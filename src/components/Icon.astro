---
// Íconos Phosphor (peso Bold) como SVG inline: sin JS ni pedidos extra.
import check from '@phosphor-icons/core/bold/check-bold.svg?raw';
import checks from '@phosphor-icons/core/bold/checks-bold.svg?raw';
import clock from '@phosphor-icons/core/bold/clock-bold.svg?raw';
import whatsapp from '@phosphor-icons/core/bold/whatsapp-logo-bold.svg?raw';

const ICONS = {
  check,
  checks,
  clock,
  whatsapp,
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span class:list={['icon', className]} aria-hidden="true" set:html={ICONS[name]} />
