---
// Botón principal "Empezar gratis" (lleva al formulario de /empezar)
import { LANDING_COPY, START_ROUTE } from '../config';

interface Props {
  label?: string;
  // En el encabezado: más bajo y angosto
  compact?: boolean;
  class?: string;
}

const { label = LANDING_COPY.cta, compact = false, class: className } = Astro.props;
---

<a class:list={['button', { 'button-compact': compact }, className]} href={START_ROUTE}>{label}</a>
