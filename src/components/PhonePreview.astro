---
// Celular inclinado con la vista previa real del recordatorio y dos etiquetas flotantes (DISENO.md, "Vista previa del
// recordatorio"). El texto es el de la plantilla que aprueba Meta, no uno de muestra.
import Icon from './Icon.astro';
import { REMINDER_PREVIEW, REMINDER_SEND_TIME } from '../config';
---

<figure class="art" aria-label="Vista previa del recordatorio por WhatsApp">
  <span class="orb" aria-hidden="true"></span>
  <p class="tag tag-top">
    <span class="tag-icon"><Icon name="clock" /></span>
    <span><strong>A las {REMINDER_SEND_TIME}</strong><br />del día anterior</span>
  </p>
  <div class="phone">
    <div class="phone-screen">
      <div class="chat-head">
        <span class="chat-avatar"><Icon name="calendarCheck" /></span>
        <span><strong>Recordatorio de turno</strong><br />Vista previa</span>
      </div>
      <div class="chat">
        <p class="chat-day">{REMINDER_PREVIEW.day}</p>
        <div class="bubble">
          <p>{REMINDER_PREVIEW.message}</p>
          <p class="bubble-time">{REMINDER_SEND_TIME}</p>
        </div>
        <ul class="replies">
          {REMINDER_PREVIEW.replies.map((reply) => <li>{reply}</li>)}
        </ul>
      </div>
    </div>
  </div>
  <p class="tag tag-bottom">
    <span class="tag-icon"><Icon name="check" /></span>
    <span><strong>Confirma o cancela</strong><br />con un botón</span>
  </p>
</figure>

<style>
  /* Colores del chat de muestra: imitan la pantalla de WhatsApp, no son parte de la marca */
  .art {
    --chat-bg: #efeae2;
    --chat-text: #111b21;
    --chat-soft: #54656f;
    --chat-reply: #00618a;

    position: relative;
    display: grid;
    place-items: center;
    min-height: 32rem;
    margin: 0;
  }

  .orb {
    position: absolute;
    width: 19.5rem;
    height: 19.5rem;
    background: var(--tint);
    border-radius: 50%;
  }

  .phone {
    position: relative;
    z-index: 2;
    width: 18rem;
    padding: 0.5625rem;
    background: var(--ink);
    border-radius: 2rem;
    box-shadow: 0 24px 50px rgb(16 16 16 / 0.18);
    transform: rotate(-2deg);
  }

  .phone-screen {
    overflow: hidden;
    background: var(--surface);
    border-radius: 1.5rem;
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--chat-soft);
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .chat-head strong {
    color: var(--chat-text);
  }

  .chat-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--tint);
    border-radius: 50%;
    color: var(--link);
  }

  .chat-avatar :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .chat {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 0.625rem;
    background: var(--chat-bg);
    color: var(--chat-text);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .chat-day {
    justify-self: center;
    margin-bottom: 0.375rem;
    padding: 0.125rem 0.625rem;
    background: var(--surface);
    border-radius: 8px;
    color: var(--chat-soft);
  }

  .bubble {
    padding: 0.5625rem 0.625rem 0.3125rem;
    background: var(--surface);
    border-radius: 4px 12px 12px 12px;
  }

  .bubble-time {
    color: var(--chat-soft);
    text-align: right;
  }

  .replies {
    display: grid;
    gap: 0.1875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .replies li {
    padding: 0.4375rem;
    background: var(--surface);
    border-radius: 10px;
    color: var(--chat-reply);
    font-weight: 700;
    text-align: center;
  }

  .tag {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-btn);
    box-shadow: var(--shadow-soft);
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .tag strong {
    color: var(--text);
  }

  .tag-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--tint);
    border-radius: 10px;
    color: var(--link);
  }

  .tag-icon :global(.icon) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .tag-top {
    top: 0.625rem;
    right: 0;
  }

  .tag-bottom {
    bottom: 0.625rem;
    left: 0;
  }
</style>
