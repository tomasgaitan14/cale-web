---
// Marca de Cale: "cale" en minúscula + cuadrado negro con el calendario y tilde en verde (DISENO.md, "Marca")
import Icon from './Icon.astro';
---

<span class="brand"><span class="brand-mark"><Icon name="calendarCheck" /></span>cale</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5625rem;
    color: var(--text);
    font: var(--fw-head) 1.5rem/1 var(--font-head);
    letter-spacing: -0.05em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    background: var(--ink);
    border-radius: 10px;
  }

  /* El verde va como relleno del ícono sobre negro, nunca como color de texto */
  .brand-mark :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* En el svg mismo: el atributo fill="currentColor" de Phosphor le gana a un fill heredado */
  .brand-mark :global(svg) {
    fill: var(--accent);
  }
</style>
