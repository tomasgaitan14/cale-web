---
// Marca de Cale: isotipo (doble tilde sobre ficha negra) + "cale" en minúscula. El dibujo sale de lib/brand.ts;
// las reglas de uso, en docs/brand/manual-de-marca.md.
import { MARK_RADIUS, MARK_SIZE, MARK_STROKE, MARK_TICKS, tickPath } from '../lib/brand';
---

<span class="brand"><svg
    class="brand-mark"
    viewBox={`0 0 ${MARK_SIZE} ${MARK_SIZE}`}
    aria-hidden="true"
    focusable="false"
  ><rect class="mark-tile" width={MARK_SIZE} height={MARK_SIZE} rx={MARK_RADIUS} /><g
      class="mark-ticks"
      stroke-width={MARK_STROKE}
    >{MARK_TICKS.map(({ points, opacity }) => <path d={tickPath(points)} stroke-opacity={opacity} />)}</g
  ></svg>cale</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5625rem;
    color: var(--text);
    font: var(--fw-head) 1.5rem/1 var(--font-head);
    letter-spacing: -0.05em;
  }

  .brand-mark {
    display: block;
    flex: none;
    width: 2.125rem;
    height: 2.125rem;
  }

  .mark-tile {
    fill: var(--ink);
  }

  /* El verde va como trazo sobre la ficha negra, nunca como color de texto ni sobre crema (contraste de 1,8:1) */
  .mark-ticks {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
